# Copy to .env (git-ignored). The stack (compose.yaml) and the mappd CLI both read it:
# compose substitutes the variables below, `mappd` picks them up as MAPPD_* settings.
#
# On a server this file becomes /opt/mappd/.env (placed by hand, never written by the
# deploy tool): change MAPPD_PG_PASSWORD, set OPENROUTER_API_KEY, and point the mail
# HOST/PORT/TLS values below at the real mail servers — the deploy overlay passes exactly
# those to the app and migrate services.

# The one required setting for real models (leave empty with gateway.mocks.yaml):
OPENROUTER_API_KEY=

# --- Postgres ---------------------------------------------------------------
# Credentials feed compose and, on the host, the CLI's database URL defaults.
MAPPD_PG_USER=mappd
MAPPD_PG_PASSWORD=mappd
MAPPD_PG_PORT=5432

# --- Host ports ---------------------------------------------------------------
MAPPD_MLFLOW_PORT=5001        # 5000 is taken by macOS (AirPlay)
MAPPD_GATEWAY_PORT=4000
MAPPD_GATEWAY_MCP_PORT=3000
MAPPD_APP_PORT=8000
MAPPD_MOCK_LLM_PORT=9000
MAPPD_GREENMAIL_SMTP_PORT=3025
MAPPD_GREENMAIL_IMAP_PORT=3143
MAPPD_GREENMAIL_API_PORT=8080
MAPPD_MOCK_WEBHOOK_PORT=9200
MAPPD_MOCK_TELEGRAM_PORT=9300
MAPPD_MOCK_MCP_PORT=9400

# --- Gateway ------------------------------------------------------------------
# Config mounted into agentgateway: gateway.yaml (real providers) or
# gateway.mocks.yaml (deterministic mocks, no provider key needed).
MAPPD_GATEWAY_CONFIG=gateway.yaml
# Where the gateway reaches the mock models. Default (container): http://mock-llm:9000/v1;
# dev with `mappd mock llm` on the host: http://host.docker.internal:9000/v1
# MAPPD_MOCK_LLM_URL=http://mock-llm:9000/v1
# MAPPD_MOCK_MCP_URL=http://mock-mcp:9400

# --- Images ---------------------------------------------------------------------
# MAPPD_PG_IMAGE=pgvector/pgvector:0.8.1-pg17
# MAPPD_MLFLOW_IMAGE=mappd-mlflow:3.17.0
# MAPPD_GATEWAY_IMAGE=ghcr.io/agentgateway/agentgateway:v1.6.0
# MAPPD_APP_IMAGE=mappd-app:local
# MAPPD_GREENMAIL_IMAGE=greenmail/standalone:2.1.14

# --- Versions ---------------------------------------------------------------------
# Empty: the app image bakes in a hash of the code. Set the git SHA to deploy.
MAPPD_APP_VERSION=

# --- Webhooks -------------------------------------------------------------------
# Where support events (created, approval_needed, escalated, closed) are POSTed, signed with
# HMAC-SHA256 (X-Mappd-Signature). Empty: no webhooks. Receivers verify with
# mappd.events.verify and deduplicate by X-Mappd-Event-Id.
# With the mocks profile: http://mock-webhook:9200/hook
MAPPD_SUPPORT_WEBHOOK_URL=
MAPPD_SUPPORT_WEBHOOK_SECRET=
MAPPD_RFQ_WEBHOOK_URL=
MAPPD_RFQ_WEBHOOK_SECRET=

# --- Mail -----------------------------------------------------------------------
# One mailbox per process (support, rfq): the app polls it over IMAP and replies over SMTP.
# MAIL_MODE: imap or off. These values reach the stack's GreenMail from the host (`mappd serve`);
# the app container reaches it as greenmail:3143/3025 (compose.app.yaml).
# TLS: ssl, starttls or none. BACKFILL=true reads mail already in the inbox on the first poll.
MAPPD_MAIL_POLL_SECONDS=30
MAPPD_SUPPORT_MAIL_MODE=imap
MAPPD_SUPPORT_MAIL_FROM=support@mappd.test
MAPPD_SUPPORT_IMAP_HOST=127.0.0.1
MAPPD_SUPPORT_IMAP_PORT=3143
MAPPD_SUPPORT_IMAP_TLS=none
MAPPD_SUPPORT_IMAP_USER=support@mappd.test
MAPPD_SUPPORT_IMAP_PASSWORD=mappd
MAPPD_SUPPORT_IMAP_BACKFILL=false
MAPPD_SUPPORT_SMTP_HOST=127.0.0.1
MAPPD_SUPPORT_SMTP_PORT=3025
MAPPD_SUPPORT_SMTP_TLS=none
MAPPD_SUPPORT_SMTP_USER=support@mappd.test
MAPPD_SUPPORT_SMTP_PASSWORD=mappd
MAPPD_RFQ_MAIL_MODE=imap
MAPPD_RFQ_MAIL_FROM=rfq@mappd.test
MAPPD_RFQ_IMAP_HOST=127.0.0.1
MAPPD_RFQ_IMAP_PORT=3143
MAPPD_RFQ_IMAP_TLS=none
MAPPD_RFQ_IMAP_USER=rfq@mappd.test
MAPPD_RFQ_IMAP_PASSWORD=mappd
MAPPD_RFQ_IMAP_BACKFILL=false
MAPPD_RFQ_SMTP_HOST=127.0.0.1
MAPPD_RFQ_SMTP_PORT=3025
MAPPD_RFQ_SMTP_TLS=none
MAPPD_RFQ_SMTP_USER=rfq@mappd.test
MAPPD_RFQ_SMTP_PASSWORD=mappd

# --- Autonomy -------------------------------------------------------------------
# The support and RFQ processes' autonomy policy files. Empty: processes/<name>/autonomy.yaml,
# which is reviewed like code (mappd process shadow|autonomy edit it). Tests point them elsewhere.
MAPPD_SUPPORT_AUTONOMY=
MAPPD_RFQ_AUTONOMY=

# --- Installation: Telegram ---------------------------------------------------------
# polling (development, no public URL), webhook (production) or off. With the mocks profile:
# MAPPD_INSTALLATION_TELEGRAM_API_URL=http://mock-telegram:9300 and any token.
MAPPD_INSTALLATION_TELEGRAM_MODE=off
MAPPD_INSTALLATION_TELEGRAM_TOKEN=
MAPPD_INSTALLATION_TELEGRAM_API_URL=
MAPPD_INSTALLATION_TELEGRAM_SECRET=
# The bot's username from @BotFather, without @: deep links name it (default helio_install_bot).
MAPPD_INSTALLATION_BOT_NAME=
# The systems' MCP endpoint (the gateway's /mcp); the app's default is http://127.0.0.1:3000/mcp.
MAPPD_INSTALLATION_MCP_URL=

# --- Authentication ------------------------------------------------
# none (default, local dev: anyone who reaches the app can act), jwt (built-in users
# table, `mappd user add`), header (a proxy asserts the user), or a
# `module.path:factory` import string for a custom backend.
MAPPD_AUTH=none
# jwt only: HS256 secret, at least 32 chars (`openssl rand -hex 32`). Rotating it
# invalidates every session and token.
MAPPD_AUTH_SECRET=
# jwt only: token and session-cookie lifetime in hours.
MAPPD_AUTH_TOKEN_HOURS=
# header only: which headers carry the name and the comma-separated roles. The proxy
# MUST strip them from client requests.
MAPPD_AUTH_HEADER=
MAPPD_AUTH_ROLES_HEADER=
# jwt only: on = the mappd_session cookie is Secure (HTTPS); off for plain-HTTP dev.
MAPPD_AUTH_COOKIE_SECURE=

# --- Workflow dashboard -----------------------------------------------------------
# /workflows and /api/v1/workflows show workflow inputs, outputs and step results (customer
# text). off: metadata only — names, statuses, timings and errors.
MAPPD_WORKFLOWS_PAYLOADS=on

# --- CLI --------------------------------------------------------------------------
# MAPPD_LOG_LEVEL=WARNING   # CLI log level: DEBUG, INFO, WARNING, ERROR
